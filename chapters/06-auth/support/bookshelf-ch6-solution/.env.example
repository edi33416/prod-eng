# Copy to .env and change every secret. Never commit .env.
POSTGRES_USER=bookshelf
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bookshelf

# At least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=15

# From your GitHub OAuth App (Settings -> Developer settings -> OAuth Apps).
# Leave empty to disable GitHub login.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Comma-separated list of browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=

# Local development over plain http://localhost only. Keep "true" anywhere
# else: the OAuth state cookie must never travel over plain HTTP.
COOKIE_SECURE=false
